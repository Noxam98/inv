# SQLite file location. In Docker/Fly mount /data as a volume.
DB_PATH=./data/inds.db

# Session cookie name and lifetime (seconds, 30 days).
SESSION_COOKIE=inds_session
SESSION_TTL=2592000

# Set "true" in prod (HTTPS). False on localhost.
COOKIE_SECURE=false

# Cross-origin: list of allowed origins for CORS. Comma-separated. Empty = same-origin only.
CORS_ORIGINS=http://localhost:5173

# Telegram (optional, configure when wiring the bot)
TG_BOT_TOKEN=
TG_GROUP_ID=
TG_WEBHOOK_SECRET=
